# Copy to .env and fill in. NEVER commit .env. Generate secrets with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
DAPRO_ENV=demo
DAPRO_DB_NAME=dapro
DAPRO_DB_OWNER=dapro_owner
DAPRO_DB_OWNER_PASSWORD=
DAPRO_APP_DB_PASSWORD=
DAPRO_DB_HOST_PORT=55480
DAPRO_API_HOST_PORT=8410
DAPRO_WEB_HOST_PORT=8480
DAPRO_JWT_SECRET=
DAPRO_CORS_ORIGINS=http://localhost:8480
# Shared password for generated DEMO accounts (demo environment only)
DAPRO_DEMO_PASSWORD=
# Email: disabled | mock   SMS: disabled | mock   (no live provider selected: OD-16)
DAPRO_EMAIL_MODE=mock
DAPRO_SMS_MODE=mock
# Bank data adapter: none | mock   (no live bank API exists: OD-06)
DAPRO_BANK_ADAPTER=mock
